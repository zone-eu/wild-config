{
    "name": "@zone-eu/wild-config",
    "version": "1.7.9",
    "description": "Configuration management module",
    "main": "index.js",
    "types": "index.d.ts",
    "scripts": {
        "test": "node --test test/wild-config-test.js",
        "test:coverage": "c8 npm test",
        "typecheck": "tsc -p tsconfig.json",
        "lint": "npm run typecheck && eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "update": "rm -rf node_modules package-lock.json && ncu -u && npm install"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/zone-eu/wild-config.git"
    },
    "keywords": [
        "config"
    ],
    "author": "Andris Reinman",
    "license": "(MIT OR EUPL-1.1+)",
    "bugs": {
        "url": "https://github.com/zone-eu/wild-config/issues"
    },
    "homepage": "https://github.com/zone-eu/wild-config#readme",
    "engines": {
        "node": ">=20.0.0"
    },
    "dependencies": {
        "deep-extend": "0.6.0",
        "minimist": "1.2.8",
        "toml": "5.0.1"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@types/deep-extend": "0.6.2",
        "@types/minimist": "1.2.5",
        "@types/node": "26.6.5",
        "c8": "12.0.0",
        "eslint": "10.13.0",
        "eslint-config-prettier": "10.1.8",
        "globals": "17.13.0",
        "prettier": "3.9.10",
        "typescript": "6.0.3"
    }
}
